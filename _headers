/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400, must-revalidate
  Vary: Accept-Encoding
  Access-Control-Allow-Origin: *

# 公告/版本文件优化
/notices.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400, must-revalidate
  Vary: Accept-Encoding

/useragreementversion.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400, must-revalidate
  Vary: Accept-Encoding

# 字体文件
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

# 防止爬虫爬取dev域名
https://genshinlore.pages.dev/*
	X-Robots-Tag: noindex